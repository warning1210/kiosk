<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kiosk.domain.event.EventRepository">
 <resultMap id="event" type="com.kiosk.domain.event.Event"><id property="eventId" column="event_id"/><association property="flavor" javaType="com.kiosk.domain.flavor.Flavor"><id property="flavorId" column="flavor_id"/><result property="flavorName" column="flavor_name"/></association><association property="sizeUpFromProduct" javaType="com.kiosk.domain.product.Product"><id property="productId" column="size_up_from_product_id"/><result property="productName" column="from_product_name"/></association><association property="sizeUpToProduct" javaType="com.kiosk.domain.product.Product"><id property="productId" column="size_up_to_product_id"/><result property="productName" column="to_product_name"/></association><association property="creatorAdmin" javaType="com.kiosk.domain.admin.Admin"><id property="adminId" column="creator_admin_id"/><result property="name" column="creator_name"/></association></resultMap>
 <sql id="base">select e.*, f.flavor_name, pf.product_name from_product_name, pt.product_name to_product_name, a.name creator_name from event e left join flavor f on f.flavor_id=e.flavor_id left join product pf on pf.product_id=e.size_up_from_product_id left join product pt on pt.product_id=e.size_up_to_product_id join admin a on a.admin_id=e.creator_admin_id</sql>
 <select id="findByStatus" resultMap="event"><include refid="base"/> where e.status=#{status}</select>
 <select id="findByEventTypeAndStatus" resultMap="event"><include refid="base"/> where e.event_type=#{eventType} and e.status=#{status}</select>
 <select id="findByEventTypeInAndStatus" resultMap="event"><include refid="base"/> where e.event_type in <foreach collection="eventTypes" item="v" open="(" separator="," close=")">#{v}</foreach> and e.status=#{status}</select>
 <select id="findAll" resultMap="event"><include refid="base"/> order by e.created_at desc</select>
 <select id="findById" resultMap="event"><include refid="base"/> where e.event_id=#{id}</select>
 <insert id="insert" useGeneratedKeys="true" keyProperty="eventId">insert into event(event_name,event_type,benefit_type,image_url,description,discount_rate,discount_amount,flavor_id,size_up_from_product_id,size_up_to_product_id,additional_payment,target_json,start_at,end_at,status,creator_admin_id,created_at,updated_at) values(#{eventName},#{eventType},#{benefitType},#{imageUrl},#{description},#{discountRate},#{discountAmount},#{flavor.flavorId},#{sizeUpFromProduct.productId},#{sizeUpToProduct.productId},#{additionalPayment},#{targetJson},#{startAt},#{endAt},#{status},#{creatorAdmin.adminId},now(),now())</insert>
 <update id="update">update event set event_name=#{eventName},event_type=#{eventType},benefit_type=#{benefitType},image_url=#{imageUrl},description=#{description},discount_rate=#{discountRate},discount_amount=#{discountAmount},flavor_id=#{flavor.flavorId},size_up_from_product_id=#{sizeUpFromProduct.productId},size_up_to_product_id=#{sizeUpToProduct.productId},additional_payment=#{additionalPayment},target_json=#{targetJson},start_at=#{startAt},end_at=#{endAt},status=#{status},updated_at=now() where event_id=#{eventId}</update>
</mapper>
