<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kiosk.domain.stockrequest.StockRequestItemRepository"><resultMap id="item" type="com.kiosk.domain.stockrequest.StockRequestItem"><id property="stockRequestItemId" column="stock_request_item_id"/><result property="requestedQuantity" column="requested_quantity"/><result property="approvedQuantity" column="approved_quantity"/><result property="createdAt" column="created_at"/><association property="stockRequest" javaType="com.kiosk.domain.stockrequest.StockRequest"><id property="stockRequestId" column="stock_request_id"/><result property="requestStatus" column="request_status"/><association property="branch" javaType="com.kiosk.domain.branch.Branch"><id property="branchId" column="branch_id"/></association></association><association property="flavor" javaType="com.kiosk.domain.flavor.Flavor"><id property="flavorId" column="flavor_id"/><result property="flavorName" column="flavor_name"/></association></resultMap><sql id="base">select i.*,f.flavor_name,sr.branch_id,sr.request_status,sr.requested_at from stock_request_item i join flavor f on f.flavor_id=i.flavor_id join stock_request sr on sr.stock_request_id=i.stock_request_id</sql><select id="findActive" resultMap="item"><include refid="base"/> where sr.branch_id=#{branchId} and i.flavor_id=#{flavorId} and sr.request_status in <foreach collection="statuses" item="v" open="(" separator="," close=")">#{v}</foreach> order by sr.requested_at desc</select><select id="findByStockRequestIdIn" resultMap="item"><include refid="base"/> where i.stock_request_id in <foreach collection="stockRequestIds" item="v" open="(" separator="," close=")">#{v}</foreach></select><select id="findByStockRequest_StockRequestId" resultMap="item"><include refid="base"/> where i.stock_request_id=#{stockRequestId}</select><insert id="insert" useGeneratedKeys="true" keyProperty="stockRequestItemId">insert into stock_request_item(stock_request_id,flavor_id,requested_quantity,approved_quantity,created_at) values(#{stockRequest.stockRequestId},#{flavor.flavorId},#{requestedQuantity},#{approvedQuantity},now())</insert><update id="update">update stock_request_item set requested_quantity=#{requestedQuantity},approved_quantity=#{approvedQuantity} where stock_request_item_id=#{stockRequestItemId}</update></mapper>
