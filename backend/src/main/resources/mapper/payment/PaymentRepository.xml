<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.kiosk.domain.payment.PaymentRepository"><resultMap id="map" type="com.kiosk.domain.payment.Payment"><id property="paymentId" column="payment_id"/><association property="order" column="order_id" select="com.kiosk.domain.order.OrderRepository.selectById"/></resultMap><select id="selectByOrderId" resultMap="map">SELECT * FROM payment WHERE order_id=#{orderId}</select><select id="selectByQrToken" resultMap="map">SELECT * FROM payment WHERE qr_token=#{qrToken}</select><insert id="insert" useGeneratedKeys="true" keyProperty="paymentId">INSERT INTO payment(order_id,payment_method,payment_status,qr_token,qr_expires_at,requested_amount,paid_amount,approval_number,failure_reason,paid_at,payment_key) VALUES(#{order.orderId},#{paymentMethod},#{paymentStatus},#{qrToken},#{qrExpiresAt},#{requestedAmount},#{paidAmount},#{approvalNumber},#{failureReason},#{paidAt},#{paymentKey})</insert><update id="update">UPDATE payment SET payment_method=#{paymentMethod},payment_status=#{paymentStatus},qr_token=#{qrToken},qr_expires_at=#{qrExpiresAt},requested_amount=#{requestedAmount},paid_amount=#{paidAmount},approval_number=#{approvalNumber},failure_reason=#{failureReason},paid_at=#{paidAt},payment_key=#{paymentKey} WHERE payment_id=#{paymentId}</update></mapper>
