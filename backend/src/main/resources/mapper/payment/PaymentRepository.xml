<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.kiosk.domain.payment.PaymentRepository"><resultMap id="map" type="com.kiosk.domain.payment.Payment"><id property="paymentId" column="payment_id"/><result property="paymentMethod" column="payment_method"/><result property="paymentStatus" column="payment_status"/><result property="qrToken" column="qr_token"/><result property="qrExpiresAt" column="qr_expires_at"/><result property="requestedAmount" column="requested_amount"/><result property="paidAmount" column="paid_amount"/><result property="approvalNumber" column="approval_number"/><result property="failureReason" column="failure_reason"/><result property="paidAt" column="paid_at"/><result property="paymentKey" column="payment_key"/><association property="order" column="order_id" select="com.kiosk.domain.order.OrderRepository.selectById"/></resultMap><select id="selectByOrderId" resultMap="map">SELECT * FROM payment WHERE order_id=#{orderId}</select><select id="selectByQrToken" resultMap="map">SELECT * FROM payment WHERE qr_token=#{qrToken}</select>
<!-- 주문 목록 화면(BranchOrderService.getBranchOrders)처럼 결제수단만 필요할 때 쓰는 가벼운 조회.
     위 resultMap의 order association은 select= 서브쿼리라 매 행마다 Order+OrderItem을 통째로
     재조회한다 - 주문 N건짜리 목록에서 건별로 selectByOrderId를 부르면 N배로 증폭돼 심각하게 느려진다.
     이 resultMap은 order_id만 같은 행에서 바로 매핑해 서브쿼리 없이 한 번에 끝낸다. -->
<resultMap id="methodOnly" type="com.kiosk.domain.payment.Payment"><id property="paymentId" column="payment_id"/><result property="paymentMethod" column="payment_method"/><association property="order" javaType="com.kiosk.domain.order.Order"><id property="orderId" column="order_id"/></association></resultMap>
<select id="findMethodsByOrderIds" resultMap="methodOnly">SELECT payment_id, order_id, payment_method FROM payment WHERE order_id IN <foreach collection="orderIds" item="id" open="(" close=")" separator=",">#{id}</foreach></select><insert id="insert" useGeneratedKeys="true" keyProperty="paymentId">INSERT INTO payment(order_id,payment_method,payment_status,qr_token,qr_expires_at,requested_amount,paid_amount,approval_number,failure_reason,paid_at,payment_key) VALUES(#{order.orderId},#{paymentMethod},#{paymentStatus},#{qrToken},#{qrExpiresAt},#{requestedAmount},#{paidAmount},#{approvalNumber},#{failureReason},#{paidAt},#{paymentKey})</insert><update id="update">UPDATE payment SET payment_method=#{paymentMethod},payment_status=#{paymentStatus},qr_token=#{qrToken},qr_expires_at=#{qrExpiresAt},requested_amount=#{requestedAmount},paid_amount=#{paidAmount},approval_number=#{approvalNumber},failure_reason=#{failureReason},paid_at=#{paidAt},payment_key=#{paymentKey} WHERE payment_id=#{paymentId}</update></mapper>
