<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kiosk.domain.inventory.InventoryTransactionRepository">
 <insert id="insert" useGeneratedKeys="true" keyProperty="inventoryTransactionId">insert into inventory_transaction(branch_id,branch_inventory_id,flavor_id,transaction_type,change_quantity,quantity_after,reason,order_id,stock_request_id,processed_admin_id,transaction_at) values(#{branch.branchId},#{branchInventory.branchInventoryId},#{flavor.flavorId},#{transactionType},#{changeQuantity},#{quantityAfter},#{reason},#{order.orderId},#{stockRequest.stockRequestId},#{processedAdmin.adminId},coalesce(#{transactionAt},now()))</insert>
</mapper>
