<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.kiosk.domain.order.OrderItemRepository"><resultMap id="map" type="com.kiosk.domain.order.OrderItem"><id property="orderItemId" column="order_item_id"/><result property="productNameSnapshot" column="product_name_snapshot"/><result property="unitPriceSnapshot" column="unit_price_snapshot"/><result property="quantity" column="quantity"/><result property="itemTotal" column="item_total"/><result property="containerType" column="container_type"/><result property="spoonCount" column="spoon_count"/><result property="dryIceMinutes" column="dry_ice_minutes"/><result property="requestNote" column="request_note"/><result property="createdAt" column="created_at"/><association property="order" javaType="com.kiosk.domain.order.Order"><id property="orderId" column="order_id"/></association><association property="product" javaType="com.kiosk.domain.product.Product"><id property="productId" column="product_id"/></association></resultMap><select id="findByOrder_OrderIdOrderByOrderItemIdAsc" resultMap="map">SELECT * FROM order_item WHERE order_id=#{orderId} ORDER BY order_item_id</select>
<select id="findByOrder_OrderIdIn" resultMap="map">SELECT * FROM order_item WHERE order_id IN <foreach collection="orderIds" item="id" open="(" close=")" separator=",">#{id}</foreach> ORDER BY order_id, order_item_id</select><insert id="insert" useGeneratedKeys="true" keyProperty="orderItemId">INSERT INTO order_item(order_id,product_id,product_name_snapshot,unit_price_snapshot,quantity,item_total,container_type,spoon_count,dry_ice_minutes,request_note,created_at) VALUES(#{order.orderId},#{product.productId},#{productNameSnapshot},#{unitPriceSnapshot},#{quantity},#{itemTotal},#{containerType},#{spoonCount},#{dryIceMinutes},#{requestNote},NOW())</insert><update id="update">UPDATE order_item SET quantity=#{quantity},item_total=#{itemTotal},container_type=#{containerType},spoon_count=#{spoonCount},dry_ice_minutes=#{dryIceMinutes},request_note=#{requestNote} WHERE order_item_id=#{orderItemId}</update></mapper>
