<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kiosk.domain.order.OrderRepository">
 <resultMap id="map" type="com.kiosk.domain.order.Order"><id property="orderId" column="order_id"/><result property="kioskCode" column="kiosk_code"/><result property="orderNumber" column="order_number"/><result property="waitingNumber" column="waiting_number"/><result property="orderType" column="order_type"/><result property="pickupAt" column="pickup_at"/><result property="orderStatus" column="order_status"/><result property="language" column="language"/><result property="isEasyMode" column="is_easy_mode"/><result property="usedPoints" column="used_points"/><result property="earnedPoints" column="earned_points"/><result property="amountBeforeDiscount" column="amount_before_discount"/><result property="discountAmount" column="discount_amount"/><result property="finalAmount" column="final_amount"/><result property="cancellationReason" column="cancellation_reason"/><result property="createdAt" column="created_at"/><result property="orderCompletedAt" column="order_completed_at"/><association property="branch" javaType="com.kiosk.domain.branch.Branch"><id property="branchId" column="branch_id"/></association><association property="customer" javaType="com.kiosk.domain.customer.Customer"><id property="customerId" column="customer_id"/><result property="pointBalance" column="customer_point_balance"/><result property="grade" column="customer_grade"/></association><collection property="orderItems" column="order_id" select="com.kiosk.domain.order.OrderItemRepository.findByOrder_OrderIdOrderByOrderItemIdAsc"/></resultMap>
 <!-- "map"과 동일하지만 orderItems 서브쿼리 collection이 없다 - 목록/배치용으로, 호출부가 주문상품이
      필요 없거나(자동취소 배치) 별도로 벌크 조회해 붙이는 경우(지점 주문목록) 전용. 목록 건수만큼
      orderItems 서브쿼리가 증폭되는 N+1을 피한다. -->
 <resultMap id="listMap" type="com.kiosk.domain.order.Order"><id property="orderId" column="order_id"/><result property="kioskCode" column="kiosk_code"/><result property="orderNumber" column="order_number"/><result property="waitingNumber" column="waiting_number"/><result property="orderType" column="order_type"/><result property="pickupAt" column="pickup_at"/><result property="orderStatus" column="order_status"/><result property="language" column="language"/><result property="isEasyMode" column="is_easy_mode"/><result property="usedPoints" column="used_points"/><result property="earnedPoints" column="earned_points"/><result property="amountBeforeDiscount" column="amount_before_discount"/><result property="discountAmount" column="discount_amount"/><result property="finalAmount" column="final_amount"/><result property="cancellationReason" column="cancellation_reason"/><result property="createdAt" column="created_at"/><result property="orderCompletedAt" column="order_completed_at"/><association property="branch" javaType="com.kiosk.domain.branch.Branch"><id property="branchId" column="branch_id"/></association><association property="customer" javaType="com.kiosk.domain.customer.Customer"><id property="customerId" column="customer_id"/><result property="pointBalance" column="customer_point_balance"/><result property="grade" column="customer_grade"/></association></resultMap>
 <sql id="base">SELECT o.*,c.point_balance customer_point_balance,c.grade customer_grade FROM `order` o LEFT JOIN customer c ON c.customer_id=o.customer_id</sql>
 <select id="selectById" resultMap="map"><include refid="base"/> WHERE o.order_id=#{id}</select>
 <select id="countByBranchIdAndOrderStatusAndCreatedAtBetween" resultType="long">SELECT COUNT(*) FROM `order` WHERE branch_id=#{branchId} AND order_status=#{status} AND created_at BETWEEN #{start} AND #{end}</select>
 <select id="findByBranchIdAndOrderStatusInAndCreatedAtBetween" resultMap="listMap"><include refid="base"/> WHERE o.branch_id=#{branchId} AND o.order_status IN <foreach collection="statuses" item="s" open="(" close=")" separator=",">#{s}</foreach> AND o.created_at BETWEEN #{start} AND #{end}</select>
 <select id="findByBranchIdAndOrderStatusInOrderByCreatedAtAsc" resultMap="listMap"><include refid="base"/> WHERE o.branch_id=#{branchId} AND o.order_status IN <foreach collection="statuses" item="s" open="(" close=")" separator=",">#{s}</foreach> ORDER BY o.created_at</select>
 <select id="findCreatedAtByBranchId" resultType="java.time.LocalDateTime">SELECT created_at FROM `order` WHERE branch_id=#{branchId}</select>
 <select id="findByOrderStatusInAndCreatedAtBefore" resultMap="listMap"><include refid="base"/> WHERE o.order_status IN <foreach collection="statuses" item="s" open="(" close=")" separator=",">#{s}</foreach> AND o.created_at&lt;#{cutoff}</select>
 <select id="findMaxCashWaitingNumber" resultType="java.lang.Integer">SELECT MAX(o.waiting_number) FROM `order` o JOIN payment p ON p.order_id=o.order_id WHERE o.branch_id=#{branchId} AND p.payment_method='CASH' AND o.created_at BETWEEN #{start} AND #{end}</select>
 <select id="findMaxQrWaitingNumber" resultType="java.lang.Integer">SELECT MAX(o.waiting_number) FROM `order` o JOIN payment p ON p.order_id=o.order_id WHERE o.branch_id=#{branchId} AND p.payment_method='QR' AND o.created_at BETWEEN #{start} AND #{end}</select>
 <insert id="insert" useGeneratedKeys="true" keyProperty="orderId">INSERT INTO `order`(branch_id,kiosk_code,customer_id,order_number,waiting_number,order_type,pickup_at,order_status,language,is_easy_mode,used_points,earned_points,amount_before_discount,discount_amount,final_amount,cancellation_reason,created_at,order_completed_at) VALUES(#{branch.branchId},#{kioskCode},#{customer.customerId},#{orderNumber},#{waitingNumber},#{orderType},#{pickupAt},#{orderStatus},#{language},#{isEasyMode},#{usedPoints},#{earnedPoints},#{amountBeforeDiscount},#{discountAmount},#{finalAmount},#{cancellationReason},NOW(),#{orderCompletedAt})</insert>
 <update id="update">UPDATE `order` SET waiting_number=#{waitingNumber},order_status=#{orderStatus},earned_points=#{earnedPoints},cancellation_reason=#{cancellationReason},order_completed_at=#{orderCompletedAt} WHERE order_id=#{orderId}</update>
</mapper>
