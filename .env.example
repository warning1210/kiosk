MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# 지점 로그인/가입(Firebase Auth) 기능을 쓰려면 Firebase 콘솔에서 발급받은
# 서비스 계정 키(JSON) 파일 경로. 없으면 비워둬도 백엔드는 정상 기동됨
# (그 경우 지점 인증 관련 API만 동작 안 함).
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# 지점 개설 초대와 승인/반려 결과를 실제 이메일로 발송하려면 true로 설정합니다.
# 실제 .env 파일은 Git에 올리지 말고 각 실행 환경에서만 관리합니다.
MAIL_ENABLED=false

# 기본값은 Gmail SMTP입니다. 다른 메일 서비스를 쓰면 호스트와 포트를 변경합니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# 발송 계정과 앱 비밀번호입니다.
# Gmail 일반 로그인 비밀번호가 아니라 2단계 인증 후 발급한 앱 비밀번호를 사용합니다.
MAIL_USERNAME=your-account@gmail.com
MAIL_APP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-account@gmail.com

# 초대 메일의 신청 버튼이 이동할 프론트엔드 주소입니다.
# 다른 PC에서 메일을 열면 localhost가 동작하지 않으므로 실제 IP나 운영 도메인을 입력합니다.
APP_FRONTEND_URL=http://localhost:5173

# 지점 로그인 화면의 Cloudflare Turnstile 캡차를 서버에서 검증할 때 쓰는 Secret Key입니다.
# Cloudflare 대시보드(Turnstile > 해당 위젯)에서 Site Key와 같이 발급되는 값이며, 절대 프론트/깃에 넣지 않습니다.
# 비워두면 로그인 검증이 항상 실패합니다.
TURNSTILE_SECRET_KEY=
