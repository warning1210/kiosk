# 이 파일에는 실제 비밀값을 입력하지 않습니다.
# 실행 환경에서는 이 파일을 .env로 복사한 뒤 실제 발급값과 충분히 긴 무작위 값으로 교체하세요.
# .env와 Firebase 서비스 계정 JSON 등 실제 시크릿 파일은 Git에 커밋하지 않습니다.

# -----------------------------------------------------------------------------
# MySQL 컨테이너 (docker-compose.yml)
# -----------------------------------------------------------------------------
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# -----------------------------------------------------------------------------
# 백엔드 DB 접속 (Spring Boot)
# -----------------------------------------------------------------------------
# 로컬 Docker MySQL 사용 시 DB_PASSWORD는 MYSQL_PASSWORD와 같은 값으로 설정합니다.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=kiosk
DB_USERNAME=kiosk
DB_PASSWORD=replace-with-the-same-value-as-MYSQL_PASSWORD

# -----------------------------------------------------------------------------
# 관리자 토큰 HMAC 서명 키 (필수 시크릿)
# -----------------------------------------------------------------------------
# 환경마다 서로 다른 32바이트 이상의 무작위 값을 사용합니다.
HQ_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# -----------------------------------------------------------------------------
# Toss Payments
# -----------------------------------------------------------------------------
# 노출된 테스트 키는 폐기하고 개발자센터에서 재발급한 키를 입력합니다.
# Secret Key는 서버에서만 사용하며 실제 키는 Git에 올리지 않습니다.
TOSS_SECRET_KEY=replace-with-reissued-toss-secret-key
TOSS_CLIENT_KEY=replace-with-reissued-toss-client-key
TOSS_SUCCESS_URL=
TOSS_FAIL_URL=

# -----------------------------------------------------------------------------
# Firebase Admin SDK
# -----------------------------------------------------------------------------
# Firebase 서비스 계정 JSON 파일의 서버 내부 경로입니다. JSON 자체는 Git에 올리지 않습니다.
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# -----------------------------------------------------------------------------
# 서버 검증용 Secret Key이며 프론트엔드에 포함하면 안 됩니다.
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key

# -----------------------------------------------------------------------------
# 고객 전화번호 암호화 (필수 시크릿)
# -----------------------------------------------------------------------------
# customer.mobile_number_hash(조회용 HMAC)/mobile_number_enc(저장용 AES) 생성 키입니다.
# 둘 다 32바이트 이상, 서로 다른 무작위 값을 사용하세요 - 같은 값을 쓰면 안 됩니다.
MOBILE_NUMBER_HASH_SECRET=replace-with-at-least-32-random-bytes
MOBILE_NUMBER_ENC_SECRET=replace-with-a-different-32-random-bytes

# -----------------------------------------------------------------------------
# 메일 발송
# -----------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_APP_PASSWORD=replace-with-mail-app-password
MAIL_FROM=your-account@gmail.com

# -----------------------------------------------------------------------------
# 외부 서비스 URL (시크릿 아님)
# -----------------------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:5173
PRINTER_URL=http://localhost:7777/receipt
